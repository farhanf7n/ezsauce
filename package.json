{
  "name": "ezsauce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A curated collection of resources to help you grow as a developer and designer.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-data.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate-data.mjs",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "license": "MIT"
